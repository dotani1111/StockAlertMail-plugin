{% extends '@admin/default_frame.twig' %}

{% block title %}{{ 'stock_alert_mail.admin.config.title'|trans }}{% endblock %}
{% block sub_title %}{{ 'stock_alert_mail.admin.config.subtitle'|trans }}{% endblock %}

{% block stylesheet %}{% endblock %}

{% block main %}
<div class="c-contentsArea__cols">
    <div class="c-contentsArea__primaryCol">
        <div class="c-primaryCol">

            <div class="row justify-content-between mb-2">
                <div class="col-auto"><h2 class="head-title">{{ 'stock_alert_mail.admin.config.title'|trans }}</h2></div>
            </div>

            <form method="post" action="{{ path('stock_alert_mail_admin_config') }}">
                {{ form_widget(form._token) }}

                <div class="card rounded border-0 mb-4">
                    <div class="card-header">
                        <span>{{ 'stock_alert_mail.admin.config.section.alert'|trans }}</span>
                    </div>
                    <div class="card-body">

                        <div class="row mb-3">
                            <div class="col-3">
                                <label class="col-form-label">{{ form_label(form.threshold) }} <span class="badge badge-danger ml-1">{{ 'stock_alert_mail.admin.config.required'|trans }}</span></label>
                            </div>
                            <div class="col-9">
                                <div class="input-group" style="max-width: 200px;">
                                    {{ form_widget(form.threshold, {'attr': {'class': 'form-control'}}) }}
                                    <div class="input-group-append"><span class="input-group-text">{{ 'stock_alert_mail.admin.config.unit'|trans }}</span></div>
                                </div>
                                <small class="form-text text-muted">{{ 'stock_alert_mail.form.threshold.help'|trans }}</small>
                                {{ form_errors(form.threshold) }}
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-3">
                                <label class="col-form-label">{{ form_label(form.alertEmails) }}</label>
                            </div>
                            <div class="col-9">
                                {{ form_widget(form.alertEmails, {'attr': {'class': 'form-control'}}) }}
                                <small class="form-text text-muted">{{ 'stock_alert_mail.form.alert_emails.placeholder'|trans }}（{{ BaseInfo.email01 }}）</small>
                                {{ form_errors(form.alertEmails) }}
                            </div>
                        </div>

                    </div>
                </div>

                <div class="card rounded border-0 mb-4">
                    <div class="card-header">
                        <span>{{ 'stock_alert_mail.admin.config.section.cron'|trans }}</span>
                    </div>
                    <div class="card-body">
                        <p class="mb-1">{{ 'stock_alert_mail.admin.config.cron.description'|trans }}</p>
                        <pre class="bg-light p-3 rounded"><code>0 * * * * /path/to/php /path/to/ec-cube/bin/console eccube:plugin:stock-alert-mail</code></pre>
                        <small class="text-muted">{{ 'stock_alert_mail.admin.config.cron.note'|trans }}</small>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 text-right">
                        <button type="submit" class="btn btn-ec-conversion">{{ 'stock_alert_mail.admin.config.save'|trans }}</button>
                    </div>
                </div>

            </form>

        </div>
    </div>
</div>
{% endblock %}
