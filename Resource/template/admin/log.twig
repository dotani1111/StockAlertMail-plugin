{% extends '@admin/default_frame.twig' %}

{% block title %}{{ 'stock_alert_mail.admin.log.title'|trans }}{% endblock %}
{% block sub_title %}{{ 'stock_alert_mail.nav.title'|trans }}{% endblock %}

{% block stylesheet %}{% endblock %}

{% block main %}
<div class="c-contentsArea__cols">
    <div class="c-contentsArea__primaryCol">
        <div class="c-primaryCol">

            <div class="row justify-content-between mb-2">
                <div class="col-auto"><h2 class="head-title">{{ 'stock_alert_mail.admin.log.title'|trans }}</h2></div>
            </div>

            <div class="card rounded border-0 mb-4">
                <div class="card-header">
                    <span>{{ 'stock_alert_mail.admin.log.section'|trans }}</span>
                </div>
                <div class="card-body p-0">
                    {% if logs is empty %}
                        <p class="p-3 mb-0">{{ 'stock_alert_mail.admin.log.empty'|trans }}</p>
                    {% else %}
                        <table class="table table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>{{ 'stock_alert_mail.admin.log.col.product'|trans }}</th>
                                    <th>{{ 'stock_alert_mail.admin.log.col.class'|trans }}</th>
                                    <th>{{ 'stock_alert_mail.admin.log.col.stock'|trans }}</th>
                                    <th>{{ 'stock_alert_mail.admin.log.col.alerted_at'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for log in logs %}
                                <tr>
                                    <td>
                                        <a href="{{ url('admin_product_product_edit', {id: log.productClass.product.id}) }}">
                                            {{ log.productClass.product.name }}
                                        </a>
                                    </td>
                                    <td>
                                        {% if log.productClass.classCategory1 %}
                                            {{ log.productClass.classCategory1.name }}
                                            {% if log.productClass.classCategory2 %}
                                                / {{ log.productClass.classCategory2.name }}
                                            {% endif %}
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td>{{ log.productClass.stock }}</td>
                                    <td>{{ log.alertedAt|date('Y/m/d H:i') }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
